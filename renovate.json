{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>renovate/renovate-config:default/default",
    "local>renovate/renovate-config:default/datasource-github-releases-automerge-minor(jdx/mise)",
    "local>renovate/renovate-config:default/datasource-github-releases-automerge-major(jdx/mise)"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [ "/(^|/)Dockerfile$/" ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+ARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "kustomize v0.21.3 pulls a kube-openapi on structured-merge-diff/v7, which the workspace unifies into helm while k8s.io/apimachinery v0.37 still builds on v6. Lift once a stable apimachinery moves to v7.",
      "matchPackageNames": [ "sigs.k8s.io/kustomize/api", "sigs.k8s.io/kustomize/kyaml" ],
      "allowedVersions": "<0.21.3"
    }
  ],
  "lockFileMaintenance": {
    "commitMessageSuffix": ""
  },
  "postUpdateOptions": [ "gomodTidy", "gomodUpdateImportPaths", "gomodTidyAll" ]
}
