<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Terraform report</title>
  <style>
    :root { color-scheme: light dark; --border: #d0d7de; --muted: #6e7781; --bg: #f6f8fa; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem; line-height: 1.45; }
    h1, h2, h3 { line-height: 1.2; }
    table { border-collapse: collapse; margin: 1rem 0; min-width: 24rem; }
    th, td { border: 1px solid var(--border); padding: .4rem .6rem; text-align: left; }
    th { background: var(--bg); }
    td.number { text-align: right; }
    code { background: var(--bg); border-radius: 4px; padding: .1rem .25rem; }
    .muted { color: var(--muted); }
  </style>
</head>
<body>
  <h1>Terraform report</h1>

  <h2>Summary</h2>
  {{- if .Summary }}
  <table>
    <thead>
      <tr><th>Action</th><th>Resources</th><th>Outputs</th></tr>
    </thead>
    <tbody>
    {{- range .Summary }}
      <tr><td><code>{{ .Action }}</code></td><td class="number">{{ .ResourceCount }}</td><td class="number">{{ .OutputCount }}</td></tr>
    {{- end }}
    </tbody>
  </table>
  {{- else }}
  <p>No resource or output changes detected.</p>
  {{- end }}

  {{- if .ResourceGroups }}
  <h2>Resource changes</h2>
  {{- range .ResourceGroups }}
  <h3><code>{{ .Action }}</code> <span class="muted">({{ len .Items }})</span></h3>
  <ul>
    {{- range .Items }}
    <li><code>{{ . }}</code></li>
    {{- end }}
  </ul>
  {{- end }}
  {{- end }}

  {{- if .OutputGroups }}
  <h2>Output changes</h2>
  {{- range .OutputGroups }}
  <h3><code>{{ .Action }}</code> <span class="muted">({{ len .Items }})</span></h3>
  <ul>
    {{- range .Items }}
    <li><code>{{ . }}</code></li>
    {{- end }}
  </ul>
  {{- end }}
  {{- end }}

  {{- if .Metadata }}
  <h2>Metadata</h2>
  <table>
    <tbody>
    {{- range .Metadata }}
      <tr><th>{{ .Name }}</th><td><code>{{ .Value }}</code></td></tr>
    {{- end }}
    </tbody>
  </table>
  {{- end }}
</body>
</html>
